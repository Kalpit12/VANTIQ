# Leave DATABASE_URL unset to run in demo mode (built-in sample company, no sign-in).
# Set it to a Postgres 16 database to turn on accounts, imports and mapping.
# Use a role that is NOT a superuser: superusers bypass row-level security.
DATABASE_URL=postgres://vantiq:vantiq@localhost:5432/vantiq

# Tests (optional overrides)
# TEST_DATABASE_URL=postgres://vantiq:vantiq@localhost:5432/vantiq_test
# E2E_DATABASE_URL=postgres://vantiq:vantiq@localhost:5432/vantiq_e2e

# Accounting connections (milestone 4). Without these, the Connections screen
# offers only the sandbox. QUICKBOOKS_* come from a free developer.intuit.com
# app (redirect URI: <your origin>/api/connect/quickbooks/callback);
# QUICKBOOKS_ENVIRONMENT is "sandbox" (default) or "production".
# MERGE_API_KEY (merge.dev) adds Xero, NetSuite and Sage Intacct at launch.
# CONNECTION_SECRET_KEY encrypts stored tokens (32+ random characters; changing
# it means reconnecting); CRON_SECRET guards /api/cron/sync.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox
# MERGE_API_KEY=
# CONNECTION_SECRET_KEY=
# CRON_SECRET=

# AI explanations (milestone 5). Without a key, drafts come from built-in rules
# (free). With one, Claude drafts them; VANTIQ_AI_MODEL defaults to claude-sonnet-5-5.
# ANTHROPIC_API_KEY=
# VANTIQ_AI_MODEL=
